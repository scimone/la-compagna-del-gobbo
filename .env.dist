# Database config
POSTGRES_DB=dnd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<password>
POSTGRES_HOST=dnd-db
POSTGRES_PORT=5432

# Django config
# Leave false in production; true only for a local run over plain http.
DJANGO_DEBUG=False
# Required whenever DJANGO_DEBUG is not true (the app refuses to start without it).
DJANGO_SECRET_KEY=<key>
DJANGO_ALLOWED_HOSTS=dnd.scimone.uk
# Comma-separated, scheme required (e.g. https://dnd.scimone.uk) - needed for any domain this
# is actually served under, or POST requests (like the language switcher) get a CSRF 403.
DJANGO_CSRF_TRUSTED_ORIGINS=https://dnd.scimone.uk

# LLM config - an OpenAI-compatible chat completions endpoint, used only by the dnd-translator
# worker (docker-compose hides these three from the web container).
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Cloudflare Access (Zero Trust) in front of the tunnel: team name (or full
# <team>.cloudflareaccess.com host) and the application's AUD tag. Both set -> every request must
# carry a valid Access JWT and visitors are signed in by their Google e-mail. Empty -> off.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
