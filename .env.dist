# Database config
POSTGRES_DB=dnd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<password>
POSTGRES_HOST=dnd-db
POSTGRES_PORT=5432

# Django config
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=<key>
DJANGO_ALLOWED_HOSTS=*
# Comma-separated, scheme required (e.g. https://dnd.example.com) - needed for any domain this
# is actually served under, or POST requests (like the language switcher) get a CSRF 403.
DJANGO_CSRF_TRUSTED_ORIGINS=